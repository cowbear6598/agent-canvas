{
  "name": "agent-canvas-backend",
  "version": "2.3.9.2",
  "description": "Backend server for Agent Canvas",
  "main": "dist/index.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "AGENT_CANVAS_APP_DATA_DIR=$HOME/Documents/Development/AgentCanvas PORT=3101 AGENT_CANVAS_OPENCODE_SERVER_PORT=4106 bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "start": "bun dist/index.js",
    "prod": "cd ../frontend && bunx vite build && cd ../backend && NODE_ENV=production bun src/index.ts",
    "style": "tsc --noEmit && eslint src --ext .ts",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.227",
    "@anthropic-ai/sdk": "0.111.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opencode-ai/sdk": "1.16.0",
    "@slack/web-api": "^7.19.0",
    "discord.js": "^14.26.5",
    "fflate": "^0.8.2",
    "ignore": "^7.0.5",
    "opencode-ai": "1.16.0",
    "simple-git": "^3.36.0",
    "uuid": "^13.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.10",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "bun-types": "^1.3.8",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
